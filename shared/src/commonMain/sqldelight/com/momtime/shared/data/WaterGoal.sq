CREATE TABLE water_goal (
    pregnancy_id TEXT NOT NULL PRIMARY KEY REFERENCES pregnancy(id),
    daily_goal_ml INTEGER NOT NULL,
    nudge_times_per_day INTEGER NOT NULL DEFAULT 0
);

-- Setting a goal is an UPDATE followed by a plain INSERT when the update changed no row, both in
-- one transaction (SqlDelightWaterGoalRepository.upsert). Not ON CONFLICT ... DO UPDATE, which
-- needs SQLite 3.24 and the floor is 3.22 (ADR 0042); not INSERT OR IGNORE, which would hide a bug.
updateWaterGoal:
UPDATE water_goal SET daily_goal_ml = ?, nudge_times_per_day = ? WHERE pregnancy_id = ?;

insertWaterGoal:
INSERT INTO water_goal(pregnancy_id, daily_goal_ml, nudge_times_per_day)
VALUES (?, ?, ?);

changedRows:
SELECT changes();

selectWaterGoal:
SELECT * FROM water_goal WHERE pregnancy_id = ?;
