CREATE TABLE app_settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    quiet_hours_start TEXT,
    quiet_hours_end TEXT,
    ring_grade_daily_budget INTEGER NOT NULL DEFAULT 12,
    snooze_duration_minutes INTEGER NOT NULL DEFAULT 10,
    locale_override TEXT,
    telemetry_opt_in INTEGER NOT NULL DEFAULT 0
);

seedAppSettings:
INSERT OR IGNORE INTO app_settings(id) VALUES (0);

selectAppSettings:
SELECT * FROM app_settings WHERE id = 0;

updateQuietHours:
UPDATE app_settings SET quiet_hours_start = ?, quiet_hours_end = ? WHERE id = 0;

updateRingGradeDailyBudget:
UPDATE app_settings SET ring_grade_daily_budget = ? WHERE id = 0;

updateSnoozeDurationMinutes:
UPDATE app_settings SET snooze_duration_minutes = ? WHERE id = 0;

updateLocaleOverride:
UPDATE app_settings SET locale_override = ? WHERE id = 0;

updateTelemetryOptIn:
UPDATE app_settings SET telemetry_opt_in = ? WHERE id = 0;
