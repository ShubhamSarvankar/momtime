-- Schema version 1 to 2 (ADR 0037).
--
-- 1. app_settings gains the quiet_hours_valid CHECK. SQLite cannot add a CHECK to an existing
--    table, so the table is rebuilt: rename the old one aside, create the final definition under
--    its real name, copy, drop. A v1 row whose quiet hours cannot satisfy the CHECK (only one end
--    set, or both equal) is copied with both ends cleared rather than failing the migration.
-- 2. occurrence gains the trigger that makes terminal states immutable.

ALTER TABLE app_settings RENAME TO app_settings_v1;

CREATE TABLE app_settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    quiet_hours_start TEXT,
    quiet_hours_end TEXT,
    ring_grade_daily_budget INTEGER NOT NULL DEFAULT 12,
    snooze_duration_minutes INTEGER NOT NULL DEFAULT 10,
    locale_override TEXT,
    telemetry_opt_in INTEGER NOT NULL DEFAULT 0,
    -- Both null (no quiet hours), or both set and different. Equal times are invalid, not a
    -- full day and not no window (ADR 0037).
    CONSTRAINT quiet_hours_valid CHECK (
        (quiet_hours_start IS NULL AND quiet_hours_end IS NULL)
        OR (quiet_hours_start IS NOT NULL AND quiet_hours_end IS NOT NULL AND quiet_hours_start <> quiet_hours_end)
    )
);

INSERT INTO app_settings(
    id, quiet_hours_start, quiet_hours_end, ring_grade_daily_budget, snooze_duration_minutes,
    locale_override, telemetry_opt_in
)
SELECT
    id,
    CASE WHEN quiet_hours_start IS NOT NULL AND quiet_hours_end IS NOT NULL
        AND quiet_hours_start <> quiet_hours_end THEN quiet_hours_start END,
    CASE WHEN quiet_hours_start IS NOT NULL AND quiet_hours_end IS NOT NULL
        AND quiet_hours_start <> quiet_hours_end THEN quiet_hours_end END,
    ring_grade_daily_budget, snooze_duration_minutes, locale_override, telemetry_opt_in
FROM app_settings_v1;

DROP TABLE app_settings_v1;

CREATE TRIGGER occurrence_terminal_immutable
BEFORE UPDATE ON occurrence
BEGIN
    SELECT RAISE(ABORT, 'terminal occurrence state is immutable')
    WHERE old.state IN ('COMPLETED', 'SKIPPED', 'MISSED') AND new.state <> old.state;
END;
