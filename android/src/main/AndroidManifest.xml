<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The permissions the app declares (ADR 0050). Requesting them is a later PR; declaring them is
        what makes them requestable, and each one changes the Play declarations, so verifyManifestPermissions
        holds this list exactly.

        USE_EXACT_ALARM is granted at install and cannot be revoked; Play restricts it, and whether a
        medication reminder qualifies is an open item, with the manifest-only fallback of dropping it.
        SCHEDULE_EXACT_ALARM is the requestable one for API 31 and 32, as Android's manifest guidance says.
        On API 33 and above capability comes from whichever is held, and the code asks the platform, never
        which permission it is.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The ringer (ADR 0061). The service is a foreground service of type mediaPlayback, which from Android 14
        needs the type specific permission as well as FOREGROUND_SERVICE (declared by WorkManager, ADR 0057). Play
        asks for a declaration of what a foreground service type is used for: playing the alarm sound of a reminder
        the user set. Both are normal permissions, granted at install.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        The overlay route (ADR 0061): with this granted the app may start the ring screen from the background when a
        full screen intent is not available. It is a secondary route to showing the screen and never the way the alarm
        rings. It is a special permission the user grants in settings, and Play reviews it, so it is requested only
        when full screen intent is not available (PR 8).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        The ring's vibration (ADR 0065): the template's pattern, played with the alarm usage while the sound plays
        and stopped with it. A normal permission, granted at install, and not a Play declaration.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MomTimeApplication"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!--
            The alarm receiver (ADR 0053). Not exported: only an explicit PendingIntent that this app armed can
            reach it. A Robolectric test reads the merged manifest and fails if it is exported.
        -->
        <receiver
            android:name=".arming.AlarmReceiver"
            android:exported="false" />

        <!--
            The system broadcasts (ADR 0067): boot, an app update, a clock change, a zone change and a grant of exact alarm
            access.
            Not exported: the system sends them as the system uid, which may reach an unexported component, as
            WorkManager's own boot receiver is declared. Each is answered by unique work that dispatches Reconcile
            and calls ensureArmed, and nothing rings; a time zone change first dispatches the zone change command
            (ADR 0068). BOOT_COMPLETED only, never LOCKED_BOOT_COMPLETED, so nothing runs before the first unlock.
            A test pins this action list exactly.
        -->
        <receiver
            android:name=".system.SystemBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The notification buttons' receiver (ADR 0066). Not exported: only an explicit, immutable PendingIntent
            that this app posted can reach it. A Robolectric test reads the merged manifest and fails if it is
            exported.
        -->
        <receiver
            android:name=".delivery.RingActionReceiver"
            android:exported="false" />

        <!--
            The ring screen (ADR 0062). Not exported: it is reached by this app's own PendingIntents (the full
            screen intent, the notification, the alarm clock's show intent) and by the overlay route. It is shown
            over the lock screen and turns the screen on.
        -->
        <activity
            android:name=".ring.RingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
            The reliability check (ADR 0069). Neither is exported. The receiver is reached only by the explicit,
            immutable PendingIntent the runner armed (its own action, component and request code 0), and the screen by
            the ring screen and the alarm clock's show intent. A Robolectric test reads the merged manifest and fails if
            either is exported.
        -->
        <receiver
            android:name=".reliability.CheckReceiver"
            android:exported="false" />

        <activity
            android:name=".reliability.ReliabilityCheckActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- The ringer (ADR 0061). Not exported. A foreground service of type mediaPlayback, never started by boot. -->
        <service
            android:name=".ringer.RingerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
