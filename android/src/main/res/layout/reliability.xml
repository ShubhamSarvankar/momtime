<?xml version="1.0" encoding="utf-8"?>
<!-- The reliability check screen (ADR 0069, ADR 0070). Nothing here has a fixed width or a fixed height: at 200 percent
     font scale every label wraps and nothing is cut off. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/check_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/check_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/check_intro" />

        <Button
            android:id="@+id/check_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/check_start" />

        <TextView
            android:id="@+id/check_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

        <TextView
            android:id="@+id/check_report_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/report_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <TextView
            android:id="@+id/check_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/check_opt_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/optin_label" />

        <TextView
            android:id="@+id/check_opt_in_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/optin_copy"
            android:textAppearance="@android:style/TextAppearance.Material.Caption" />

        <Button
            android:id="@+id/check_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/export_button" />
    </LinearLayout>
</ScrollView>
