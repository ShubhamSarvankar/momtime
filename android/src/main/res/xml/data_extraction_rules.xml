<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup and device transfer on API 31 and above (ADR 0034, ADR 0044). The shared database is
    backed up whole, with its rollback journal, so a copy taken while a transaction was hot is still
    recoverable. The quarantined .corrupt copy never leaves the device. The corruption marker lives
    in the no-backup directory and is never included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="momtime.db" />
        <include domain="database" path="momtime.db-journal" />
        <exclude domain="database" path="momtime.db.corrupt" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="momtime.db" />
        <include domain="database" path="momtime.db-journal" />
        <exclude domain="database" path="momtime.db.corrupt" />
    </device-transfer>
</data-extraction-rules>
