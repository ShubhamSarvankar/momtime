<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup on API 29 and 30, where android:dataExtractionRules is ignored (ADR 0034, ADR 0044).
    Same content as data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="database" path="momtime.db" />
    <include domain="database" path="momtime.db-journal" />
    <exclude domain="database" path="momtime.db.corrupt" />
</full-backup-content>
