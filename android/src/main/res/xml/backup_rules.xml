<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup on API 29 and 30, where android:dataExtractionRules is ignored (ADR 0034, ADR 0044,
    ADR 0048, ADR 0065). Same content and the same allow-list as data_extraction_rules.xml: the shared
    database, its journal and android's settings file are in, and the android store is out because it is not
    included.
-->
<full-backup-content>
    <include domain="database" path="momtime.db" />
    <include domain="database" path="momtime.db-journal" />
    <include domain="sharedpref" path="momtime_android_settings.xml" />
    <exclude domain="database" path="momtime.db.corrupt" />
</full-backup-content>
